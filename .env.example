# Secrets for this agent. Never commit real values.
#
# The gateway reads this file at its own HERMES_HOME/.env through the home
# volume -- compose.yml passes no credentials besides AGENT_ID. The Plow
# line credential itself is ./plow-credentials (`plow-agents mint`), not here.

# Optional home-channel pin. Written in place by older agent-mgr flows;
# leave blank on a fresh plow-agents mint.
PLOW_HOME_CHANNEL=

# Plow Latch: which Mac this agent drives, and its relay credential.
# `KEY=value` at column 0 is the form that is read back.
#
# Shipped bare, with no `=`: a PRESENT key with a blank value still clobbers a
# credential the container's own environment supplies, because hermes' dotenv
# load keys off presence, not emptiness. A bare line reads as absent instead.
DOMO_DEVICE_UID
DOMO_MCP_TOKEN
