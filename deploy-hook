#!/bin/sh
# Seed the mv-* skills -- the same prefix pattern the sibling agents use
# (pt-* for the-plow-times). A prefixed name is also what keeps the
# agent-authored skills (unprefixed) apart from the shipped ones.
#
# The skills used to be :ro mounts via compose.override.yml, which meant the
# agent could not edit them -- every skill_manage write died with EROFS. The
# agent is meant to improve its own skills (better extraction phrasing, sharper
# consult prompts), so the home copy -- the same writable store where it keeps
# skills it authors itself -- is the one it runs, and this checkout is only the
# seed. A destination that exists non-empty is the agent's, edits and all, and
# divergence from the seed is normal. To force a re-seed, remove the home copy
# and deploy again.
#
# SOUL.md is the opposite kind of file: repo-owned deliberate content, not
# agent-edited state -- the same class config.yaml is in, which agent-mgr
# publishes on every deploy. So the persona is copied unconditionally, the
# skills only when absent.
#
# agent-mgr exports AGENT_HOME; cwd is not assumed -- the script finds the
# skill dirs beside itself, and a checkout without any is broken, not drifted.
set -eu
cd "$(dirname "$0")"
home="${AGENT_HOME:?agent-mgr exports this}"
skills_home="$home/skills"

found=""
for dir in mv-*; do
    [ -d "$dir" ] || { echo "memory-vault: $dir matched but is not a directory -- broken checkout" >&2; continue; }
    [ -f "$dir/SKILL.md" ] || { echo "memory-vault: $dir has no SKILL.md -- broken checkout" >&2; exit 1; }
    found="$found $dir"
    dest="$skills_home/$dir"
    # An EMPTY dir is absent, not the agent's copy: a retired mount could have
    # left its bare mountpoint behind. rmdir encodes that state directly -- it
    # removes only an empty dir, and a non-empty (agent-owned) one makes it
    # fail, which is the keep signal.
    [ ! -e "$dest" ] || rmdir "$dest" 2>/dev/null || { echo "memory-vault: keeping agent-owned $dest"; continue; }
    # Stage beside the destination and rename into place, the same shape
    # agent-mgr's fetch-tree uses: an interrupted copy leaves *.incoming,
    # never a half skill that a later deploy would mistake for the agent's.
    mkdir -p "$skills_home"
    rm -rf "$dest.incoming"
    cp -R "$dir" "$dest.incoming"
    mv "$dest.incoming" "$dest"
    echo "memory-vault: seeded $dir into $dest"
done
[ -n "$found" ] || { echo "memory-vault: no mv-* skill dirs -- broken checkout" >&2; exit 1; }

# The persona, published every deploy like config.yaml is.
if [ -f runtime/SOUL.md ]; then
    cp runtime/SOUL.md "$home/SOUL.md.incoming"
    mv "$home/SOUL.md.incoming" "$home/SOUL.md"
    echo "memory-vault: published SOUL.md to $home"
else
    echo "memory-vault: no runtime/SOUL.md -- broken checkout" >&2
    exit 1
fi
