# Descriptor for this agent. agent-mgr supplies everything else; the live
# evaluation path is compose.yml (`docker compose up --build`).
#
# One deliberate override: the config lives in runtime/ beside SOUL.md
# instead of at the root where agent-mgr's default would look for it.
AGENT_CONFIG=runtime/config.yaml
AGENT_LIVE=0
AGENT_DEPLOY_HOOK=deploy-hook

# Leftover agent-mgr inspect: the tag it uses to pick the boot contract.
# plow-agents compose builds `image:` from this Dockerfile and does not
# read this line.
AGENT_IMAGE=memory-vault-hermes-agent:local
